---
import V2Layout from '../../layouts/V2Layout.astro';
import content from '../../content/v2.json';
const home=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/v2`;
---
<V2Layout title="O mnie — Ilona Marczak | Astrologia wedyjska" section="o-mnie">
  <main id="main" class="v2-shell v2-page"><header class="v2-page-heading"><p class="v2-kicker v2-kicker-accent">04 / O MNIE</p><h1>Ilona Marczak.<br />Astrologia wedyjska.</h1></header><div class="v2-about-grid"><aside class="v2-person-panel"><p class="v2-kicker">ILONA MARCZAK / JYOTISH</p><span class="v2-person-initials" aria-hidden="true">IM.</span><p>Tradycyjna astrologia wedyjska.<br />Indywidualne opracowania.</p></aside><div class="v2-prose"><p class="v2-lead">{content.about.intro}</p>{content.about.paragraphs.map(p=><p>{p}</p>)}<h2>Moje podejście</h2><p>Jasno określam zakres analizy, wyjaśniam używane pojęcia i oddzielam interpretację od pewnej wiedzy. Jeśli temat wymaga innego rodzaju wsparcia lub wykracza poza zakres mojej pracy, mówię o tym przed przyjęciem zamówienia.</p><div class="v2-actions"><a class="v2-btn" href={`${home}/oferta/`}>Zobacz opracowania</a><a class="v2-text-link" href={`${home}/o-jyotish/`}>Więcej o Jyotish</a></div></div></div></main>
</V2Layout>
