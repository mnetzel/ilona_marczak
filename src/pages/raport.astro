---
import Layout from '../layouts/Layout.astro';
import india from '../../research/india.json';
import west from '../../research/west.json';
import visualAudit from '../../research/visual-audit.json';
const entries = [...india,...west];
const visuals = Array.isArray(visualAudit) ? visualAudit : ((visualAudit as any).entries || (visualAudit as any).sites || []);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const insights = [
  {title:'Tradycja powinna mieć konkretne źródła', text:'Najbardziej użyteczne serwisy nazywają nauczycieli, szkoły albo teksty. Sama indyjska ornamentyka nie dowodzi ciągłości przekazu. Ilona powinna opisać rzeczywistą drogę nauki dopiero po wspólnej redakcji.', refs:['IN01','WE09','WE17']},
  {title:'Sewa jest widoczna w dostępie do wiedzy', text:'Bezpłatne podręczniki, nagrania, artykuły i objaśnienia pomagają odbiorcy, zanim powstanie jakakolwiek relacja konsultacyjna. Mała, rzetelna czytelnia pasuje do początkującej osoby lepiej niż rozbudowany katalog usług.', refs:['WE01','IN10']},
  {title:'Tradycyjność i sprzedaż to różne osie', text:'W badanym zbiorze są zarówno otwarte biblioteki, jak i tradycyjne szkoły z intensywną sprzedażą. Opłata nie rozstrzyga o autentyczności przekazu. W projekcie Ilony rezygnujemy z presji zakupu i eksponujemy jasne zasady.', refs:['IN01','WE07','WE20']},
  {title:'Osoba początkująca potrzebuje uczciwej skali', text:'Kilka dobrych tekstów, prawdziwy opis nauki i granic rozmowy wystarczy. Rozbudowane instytuty są źródłem inspiracji dla treści, ale nie wzorem zakresu usług ani uprawnień Ilony.', refs:['WE12','WE19','IN23']},
  {title:'Spokój można zaprojektować bez kosmicznego spektaklu', text:'Witryny często korzystają ze zdjęć nauczycieli, złota, bordo, granatu i symboli. Lepsza czytelność pojawia się przy mniejszej liczbie elementów, dużych marginesach i klarownej hierarchii. Stąd zieleń, jasne tło i oszczędny motyw lampki.', refs:['WE15','WE23','IN23']},
  {title:'Przejrzysta rozmowa buduje zaufanie', text:'Warto objaśnić cel spotkania, potrzebne dane i granice interpretacji, a także warunki finansowe, jeśli się pojawią. Unikamy obietnic trafności, straszenia planetami i sprzedaży środków mających „usunąć” trudny los.', refs:['WE10','WE19','WE09']}
];
---
<Layout title="Raport: 50 stron Jyotish — projekt Ilony Marczak" description="Przegląd 50 witryn z Indii i Zachodu: wygląd, nawigacja, treści, tradycja oraz rekomendacje dla strony Ilony Marczak." noindex>
  <main id="main" class="report container">
    <header class="report-header"><p class="eyebrow">NOTATNIK PROJEKTOWY · 3 PAŹDZIERNIKA 2026</p><h1>50 spojrzeń na Jyotish.<br /><em>Jedna spokojna przestrzeń.</em></h1><p class="report-lead">Raport z przeglądu stron w Indiach i na Zachodzie. Co mówią o tradycji, jak prowadzą czytelnika i co z tego warto przenieść na pierwszą stronę Ilony Marczak.</p><div class="report-stats"><div><strong>50</strong><span>różnych witryn</span></div><div><strong>25 + 25</strong><span>Indie i Zachód</span></div><div><strong>PL</strong><span>autorskie opracowanie</span></div></div><div class="report-actions no-print"><a class="button" href="#katalog">Przejrzyj 50 stron</a><button class="print-button" id="print-report">Drukuj / zapisz PDF</button><a class="text-link" href={`${base}/research/zrodla.csv`} download>Pobierz zestawienie CSV</a></div></header>

    <section class="report-section" id="metoda"><p class="eyebrow">JAK POWSTAŁ RAPORT</p><h2>Zakres i sposób czytania.</h2><div class="report-two-col"><div><p>To celowy przegląd jakościowy, nie reprezentatywny ranking całego rynku. Wybrano szkoły, nauczycieli, organizacje i biblioteki, które odnoszą się do indyjskiej tradycji Jyotish. „Zachód” oznacza miejsce działalności lub zachodni kontekst odbiorców, również diasporę indyjską; nie zachodni system astrologiczny.</p><p>Każdy wpis ma źródło pierwotne i opis przeczytanych treści. Osobno sprawdzono wygląd w przeglądarce na komputerze (1440 × 1000 px). Wpisy wskazują, co dało się rzeczywiście obejrzeć. To ogląd wybranych podstron w jednym momencie, bez kupowania kursów i testowania konsultacji.</p></div><div><p>Powiązane witryny tradycji SJC oraz organizacji edukacyjnych mogą reprezentować wspólny przekaz. Liczymy odrębne witryny, nie 50 niezależnych linii nauczycielskich. Serwisy szersze niż Jyotish i mocniej komercyjne opisano jako kontekst lub materiał porównawczy.</p><p>Informacje o nauczycielach i rodowodzie wiedzy są deklaracjami autorów witryn, nie wynikiem niezależnego uwierzytelnienia. Ocena natężenia sprzedaży dotyczy komunikacji na stronie, nie jakości osoby ani skuteczności astrologii. Nazwy działów przetłumaczono; opisy są autorską syntezą, a nie pełnym tłumaczeniem cudzych tekstów.</p></div></div><p class="report-note">Raport opisuje kulturę, treść i projektowanie stron. Nie potwierdza zdolności astrologii do przewidywania zdarzeń ani nie rekomenduje porad zdrowotnych, prawnych czy finansowych.</p></section>

    <section class="report-section"><p class="eyebrow">SYNTEZA</p><h2>Wnioski dla Ilony.</h2><div class="insight-grid">{insights.map((insight,i)=><article><span class="step-number">0{i+1}</span><h3>{insight.title}</h3><p>{insight.text}</p><div class="entry-refs">{insight.refs.map(id=><a href={`#${id}`}>{id}</a>)}</div></article>)}</div></section>

    <section class="report-section"><p class="eyebrow">WYGLĄD I STRUKTURA</p><h2>Pięć powtarzających się modeli.</h2><div class="table-scroll"><table><thead><tr><th>Model</th><th>Wygląd i działy</th><th>Warto wykorzystać</th><th>Do ograniczenia</th></tr></thead><tbody>
      <tr><th>Biblioteka nauczyciela</th><td>Tekstowe listy, proste menu; artykuły, książki, nagrania, narzędzia. Przykłady: WE01, IN10.</td><td>Otwarty dostęp, źródła, skromny język.</td><td>Gęste listy linków i niewielka typografia.</td></tr>
      <tr><th>Szkoła i przekaz</th><td>Zdjęcia nauczycieli, opisy linii, stopnie nauki, sylabusy, kalendarze. Przykłady: IN01, WE17.</td><td>Jawne pochodzenie wiedzy i porządek nauki.</td><td>Przenoszenie autorytetu szkoły na osobę początkującą.</td></tr>
      <tr><th>Instytucja / czasopismo</th><td>Kolumny, aktualności, archiwa, oddziały, publikacje. Przykłady: IN11, WE05.</td><td>Datowane treści, kategorie, łatwo odnajdywane zasoby.</td><td>Portalowa złożoność małej wizytówki.</td></tr>
      <tr><th>Osobista praktyka</th><td>Biografia, podejście, opis konsultacji, FAQ, kontakt. Przykłady: WE12, WE19.</td><td>Ludzki ton i jasny przebieg spotkania.</td><td>Opinie, kwalifikacje i deklaracje bez potwierdzenia.</td></tr>
      <tr><th>Kursy i oferta</th><td>Duże przyciski, pakiety, sklep, zapisy, testimoniale. Przykłady: WE07, WE20.</td><td>Przejrzyste warunki, gdy oferta rzeczywiście powstanie.</td><td>Presja, pilność i rozbudowana ścieżka zakupu.</td></tr>
    </tbody></table></div><p class="report-note">Modele się przenikają. Indyjskie serwisy w tym zbiorze częściej pokazują gęstą strukturę instytucji i tradycyjną symbolikę; wiele zachodnich mocniej eksponuje osobę prowadzącą, kurs lub konsultację. To obserwacja wybranej próby, nie reguła kulturowa.</p></section>

    <section class="report-section"><p class="eyebrow">PROPOZYCJA WDROŻONA NA STRONIE</p><h2>Treść, która może spokojnie rosnąć.</h2><div class="table-scroll"><table><thead><tr><th>Dział</th><th>Rola</th><th>Co przygotowano</th></tr></thead><tbody>
      <tr><th>Powitanie</th><td>Wyjaśnić charakter miejsca.</td><td>Łagodne wprowadzenie, bez obietnic przepowiadania losu.</td></tr><tr><th>O mnie</th><td>Przedstawić Ilonę uczciwie.</td><td>Początek drogi nauki i proponowane wartości; bez nazwisk nauczycieli i certyfikatów.</td></tr><tr><th>O Jyotish</th><td>Pomóc osobie początkującej.</td><td>Krótkie wprowadzenie, artykuł i osiem pojęć słowniczka.</td></tr><tr><th>Sewa</th><td>Wyjaśnić intencję.</td><td>Dzielenie się wiedzą, życzliwość i przejrzystość zasad.</td></tr><tr><th>O rozmowie</th><td>Pokazać proponowane podejście.</td><td>Trzy kroki rozmowy, granice i uczciwa informacja o braku zapisów.</td></tr><tr><th>Czytelnia</th><td>Dać wartość bez sprzedaży.</td><td>Trzy pełne artykuły po polsku z linkami do dalszego czytania.</td></tr><tr><th>Pytania i kontakt</th><td>Rozwiać wątpliwości.</td><td>FAQ, miejsce na rzeczywisty e-mail, obecnie bez zbierania danych.</td></tr>
    </tbody></table></div><div class="editorial-note"><h3>Do wspólnej redakcji z Iloną</h3><p>Wszystkie wypowiedzi w pierwszej osobie są proponowanymi tekstami. Potwierdzone wejściowo są imię i nazwisko oraz początek nauki Jyotish. Przed uznaniem wersji za ostateczną warto dopisać rzeczywisty przebieg nauki, nauczycieli za ich zgodą, kontakt, dostępność i zasady ewentualnych spotkań. Nie przypisano Ilonie afiliacji z żadnym badanym serwisem.</p><p>Ilustracja dziedzińca została wygenerowana na potrzeby projektu. Nie przedstawia Ilony ani miejsca jej praktyki. Strona nie zawiera fikcyjnych opinii, osiągnięć, zdjęcia portretowego ani działającego pozornie formularza.</p></div></section>

    <section class="report-section" id="katalog"><p class="eyebrow">KATALOG ŹRÓDEŁ</p><h2>50 stron, każda z osobnym opisem.</h2><p>Rozwiń wpis, aby przeczytać o dziale treści, przekazie i wnioskach. Poziom sprzedaży: „niski” — głównie zasoby i informacja; „średni” — mieszanka wiedzy i oferty; „wysoki” — wyraźna przewaga zapisów, produktów lub pakietów.</p><div class="report-controls"><div class="filter-buttons" role="group" aria-label="Region źródła"><button class="active" data-region="all" aria-pressed="true">Wszystkie (50)</button><button data-region="Indie" aria-pressed="false">Indie (25)</button><button data-region="Zachód" aria-pressed="false">Zachód (25)</button></div><label class="report-search">Szukaj w raporcie<input id="report-search" type="search" placeholder="Nazwa, kraj, temat…" /></label><button id="expand-all" class="print-button" aria-expanded="false">Rozwiń opisy</button></div><p id="result-count" role="status" class="result-count">Widoczne: 50 z 50</p><p id="no-results" hidden>Brak wyników. Zmień hasło lub wybierz wszystkie regiony.</p><div class="report-entries">{entries.map(entry=>{
      const visual = visuals.find((v:any)=>v.id===entry.id);
      const visualText = visual?.designPL || visual?.observationPL || visual?.observationsPL || visual?.visualDescriptionPL || visual?.notesPL || visual?.observations || '';
      return <details class="report-entry" id={entry.id} data-region={entry.region} data-search={`${entry.name} ${entry.country} ${entry.type} ${entry.sections.join(' ')} ${entry.contentPL} ${entry.traditionEvidence}`.toLocaleLowerCase('pl')}><summary><span class="entry-id">{entry.id}</span><span class="entry-title"><strong>{entry.name}</strong><span>{entry.country} · {entry.type}</span></span><span class="entry-region">{entry.region}</span><span class="faq-plus" aria-hidden="true">+</span></summary><div class="entry-detail"><div class="entry-link"><a href={entry.url} target="_blank" rel="noopener noreferrer">{entry.url}</a><span>Natężenie sprzedaży: {entry.commercialLevel}</span></div><dl><div><dt>Związek z tradycją</dt><dd>{entry.traditionEvidence}</dd></div><div><dt>Wygląd i układ</dt><dd>{visualText ? visualText : entry.designPL}</dd>{visualText && <dd class="structure-note">Struktura treści: {entry.designPL}</dd>}</div><div><dt>Działy / nawigacja</dt><dd>{entry.sections.join(' · ')}</dd></div><div><dt>Co można przeczytać?</dt><dd>{entry.contentPL}</dd></div><div><dt>Wniosek dla Ilony</dt><dd>{entry.takeawayPL}</dd></div><div><dt>Ograniczenia / uwagi</dt><dd>{entry.cautionPL}</dd></div></dl><p class="evidence-method"><strong>Sposób przeglądu:</strong> {entry.evidenceMethod} {visual && <span> Osobny ogląd wizualny: pierwszy ekran w przeglądarce, 1440 × 1000 px. <a href={visual.url} target="_blank" rel="noopener noreferrer">Obejrzana strona</a>. {visual.limitations && `Ograniczenia oglądu: ${visual.limitations}`}</span>}</p><p class="evidence-method"><strong>Przeczytane źródła:</strong> {entry.pagesReviewed.map((url,i)=><Fragment>{i>0 && ' · '}<a href={url} rel="noopener noreferrer" target="_blank">Źródło {i+1}</a></Fragment>)} · Data przeglądu: {entry.checkedDate}</p></div></details>;
    })}</div></section>
    <section class="report-section report-conclusion"><h2>Od inspiracji do własnego głosu.</h2><p>Najlepszym kolejnym krokiem jest wspólne przeczytanie tekstów i usunięcie zdań, których Ilona sama by nie powiedziała. Ten projekt daje strukturę i punkt wyjścia — jej doświadczenie nada mu ostateczny charakter.</p><a class="button" href={`${base}/`}>Zobacz stronę Ilony</a></section>
  </main>
</Layout>
<style>
  .report{padding-top:75px;padding-bottom:80px}.report-header{max-width:950px;padding-bottom:70px}.report h1{font-size:clamp(3rem,5vw,4.9rem)}.report-lead{font-size:18px;color:var(--muted);max-width:800px;margin-top:30px}.report-stats{display:flex;gap:70px;margin:42px 0}.report-stats strong{display:block;font:43px var(--serif)}.report-stats span{font-size:12px;color:var(--muted)}.report-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap}.print-button{background:transparent;border:1px solid #adb7a5;color:var(--forest);padding:11px 17px;font-size:13px}.report-section{padding:65px 0;border-top:1px solid var(--line)}.report-section>h2{margin-bottom:30px}.report-section>p{color:var(--muted)}.report-two-col{display:grid;grid-template-columns:1fr 1fr;gap:50px;font-size:15px;color:var(--muted)}.report-note{font-size:13px;border-left:2px solid var(--gold);padding-left:20px;margin-top:30px}.insight-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px}.insight-grid h3{font-size:28px;margin:16px 0}.insight-grid p{font-size:14px;color:var(--muted)}.entry-refs{display:flex;gap:12px;margin-top:18px;font-size:12px;color:#77623f}.table-scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:14px;text-align:left}th,td{padding:18px 16px;vertical-align:top;border-bottom:1px solid var(--line);min-width:140px}thead{background:var(--pale)}thead th{font-size:12px;letter-spacing:.03em}td{color:var(--muted)}.editorial-note{background:var(--pale);padding:32px;margin-top:35px}.editorial-note h3{margin-bottom:18px}.editorial-note p{font-size:14px;color:var(--muted)}.report-controls{display:flex;align-items:end;gap:20px;flex-wrap:wrap;margin:32px 0 20px}.filter-buttons{display:flex;gap:8px;flex-wrap:wrap}.filter-buttons button{background:transparent;border:1px solid #b7bfad;padding:11px 15px;font-size:13px;color:var(--forest)}.filter-buttons button.active{background:var(--forest);color:white}.report-search{display:flex;flex-direction:column;gap:5px;font-size:12px}.report-search input{font-size:14px;border:1px solid #b7bfad;padding:9px 12px;background:var(--white);color:var(--ink);max-width:100%}.result-count{font-size:13px;margin-bottom:22px}.report-entry{border-top:1px solid var(--line);scroll-margin-top:110px}.report-entry:last-child{border-bottom:1px solid var(--line)}.report-entry>summary{display:flex;align-items:center;gap:20px;padding:24px 0;cursor:pointer;list-style:none}.report-entry>summary::-webkit-details-marker{display:none}.entry-id{font-size:12px;color:#83653d;min-width:40px}.entry-title{display:flex;flex-direction:column;gap:5px;flex:1}.entry-title strong{font-size:16px;font-weight:500}.entry-title>span{font-size:12px;color:var(--muted)}.entry-region{font-size:11px;background:var(--pale);padding:3px 10px}.report-entry[open] summary .faq-plus{transform:rotate(45deg)}.entry-detail{padding:0 0 32px 60px}.entry-link{display:flex;justify-content:space-between;gap:20px;margin-bottom:25px;flex-wrap:wrap}.entry-link>a{font-size:13px;overflow-wrap:anywhere}.entry-link>span{font-size:12px;color:var(--muted)}.entry-detail dl{margin:0}.entry-detail dl>div{margin:18px 0}.entry-detail dt{font-size:12px;text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px}.entry-detail dd{margin:0;font-size:14px;color:var(--muted)}.entry-detail .structure-note{margin-top:10px;font-size:13px}.evidence-method{font-size:12px;color:var(--muted);margin-top:20px}.report-conclusion{max-width:800px}.report-conclusion .button{margin-top:28px}[hidden]{display:none!important}
  @media(max-width:800px){.insight-grid{grid-template-columns:1fr 1fr;gap:30px}.report-two-col{gap:30px}.entry-detail{padding-left:0}.report-controls{align-items:stretch}}@media(max-width:580px){.report{padding-top:45px}.report-header{padding-bottom:40px}.report h1{font-size:3.3rem}.report-stats{gap:25px}.report-stats strong{font-size:36px}.report-stats span{font-size:10px}.report-lead{font-size:16px}.report-section{padding-block:45px}.report-two-col,.insight-grid{grid-template-columns:1fr}.entry-region{display:none}.report-entry>summary{gap:13px}.entry-title strong{font-size:14px}.entry-title>span{font-size:11px}.entry-id{min-width:32px}.editorial-note{padding:23px}.report-actions{gap:18px}}
  @media print{.report{padding:0}.report-header{padding-bottom:20px}.report h1{font-size:32pt}.report-section{padding:20px 0}.report-stats{margin:20px 0}.report-actions{display:none}.insight-grid{grid-template-columns:1fr 1fr;gap:18px}.entry-detail{padding:0 0 20px}.report-entry>summary{padding:15px 0}.entry-region,.faq-plus{display:none}.report-entry{break-inside:avoid}.entry-detail a{overflow-wrap:anywhere}.report-two-col{display:block}.report-entry[hidden]{display:block!important}th,td{padding:10px;min-width:0}.report-entries{font-size:10pt}}
</style>
<script>
  const entries = [...document.querySelectorAll<HTMLDetailsElement>('.report-entry')];
  let region = 'all';
  let expanded = false;
  const search = document.querySelector<HTMLInputElement>('#report-search');
  const count = document.querySelector('#result-count');
  const expandButton = document.querySelector<HTMLButtonElement>('#expand-all');
  function filter() {
    const query = (search?.value || '').trim().toLocaleLowerCase('pl');
    let visible=0;
    entries.forEach(entry=>{const show=(region==='all'||entry.dataset.region===region)&&(!query||(entry.dataset.search||'').includes(query));entry.hidden=!show;if(show)visible++;});
    if(count)count.textContent=`Widoczne: ${visible} z ${entries.length}`;
    const empty=document.querySelector<HTMLElement>('#no-results');if(empty)empty.hidden=visible!==0;
  }
  document.querySelectorAll<HTMLButtonElement>('[data-region]').forEach(button=>{if(button.tagName!=='BUTTON')return;button.addEventListener('click',()=>{region=button.dataset.region||'all';document.querySelectorAll<HTMLButtonElement>('.filter-buttons button').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});filter();});});
  search?.addEventListener('input',filter);
  expandButton?.addEventListener('click',()=>{expanded=!expanded;entries.filter(e=>!e.hidden).forEach(e=>e.open=expanded);expandButton.textContent=expanded?'Zwiń opisy':'Rozwiń opisy';expandButton.setAttribute('aria-expanded',String(expanded));});
  function revealHash(){const id=decodeURIComponent(location.hash.slice(1));const entry=entries.find(e=>e.id===id);if(entry){if(entry.hidden){region='all';if(search)search.value='';document.querySelectorAll<HTMLButtonElement>('.filter-buttons button').forEach(b=>{const active=b.dataset.region==='all';b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});filter();}entry.open=true;setTimeout(()=>entry.scrollIntoView({block:'start'}),40);}}
  window.addEventListener('hashchange',revealHash);revealHash();
  let printState:{open:boolean,hidden:boolean}[]=[];
  window.addEventListener('beforeprint',()=>{printState=entries.map(e=>({open:e.open,hidden:e.hidden}));entries.forEach(e=>{e.open=true;e.hidden=false;});});
  window.addEventListener('afterprint',()=>entries.forEach((e,i)=>{if(printState[i]){e.open=printState[i].open;e.hidden=printState[i].hidden;}}));
  document.querySelector('#print-report')?.addEventListener('click',()=>window.print());
</script>
