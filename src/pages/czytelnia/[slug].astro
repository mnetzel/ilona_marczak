---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../content/articles';
export function getStaticPaths() { return articles.map(article => ({ params:{slug:article.slug}, props:{article} })); }
const { article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title={`${article.title} — Ilona Marczak`} description={article.intro}>
  <main id="main" class="prose">
    <a class="back-link" href={`${base}/#czytelnia`}>Wróć do czytelni</a>
    <p class="eyebrow">CZYTELNIA · {article.category}</p>
    <h1>{article.title}</h1><p class="lead">{article.intro}</p>
    {article.sections.map(section=><section><h2>{section.title}</h2>{section.paragraphs.map(p=><p>{p}</p>)}</section>)}
    {'glossary' in article && article.glossary && <section><h2>Mały słownik na początek</h2><dl class="glossary">{article.glossary.map(([term,definition])=><div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl></section>}
    <aside class="source-list"><p><strong>Do dalszego czytania</strong></p><ul>{article.sources.map(([label,url])=><li><a href={url} rel="noopener noreferrer" target="_blank">{label}</a></li>)}</ul><p>Tekst jest autorskim opracowaniem po polsku. Linki prowadzą do materiałów o tradycji, nie są potwierdzeniem skuteczności astrologii ani deklaracją afiliacji Ilony.</p></aside>
    <a class="text-link" href={`${base}/#czytelnia`}>Pozostałe teksty w czytelni</a>
  </main>
</Layout>
